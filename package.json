{
  "name": "khmurakami.github.io",
  "version": "1.0.0",
  "description": "A personal portfolio built as a 2.5D pixel-art rooftop side-scroller",
  "main": "js/world-main.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "assets": "node scripts/asset_spec.mjs",
    "check:assets": "node scripts/check_assets.mjs",
    "posts": "node scripts/build_posts.mjs",
    "check:posts": "node scripts/build_posts.mjs --check",
    "meta": "node scripts/build_site_meta.mjs",
    "check:meta": "node scripts/build_site_meta.mjs --check",
    "images": "python scripts/optimize_assets.py",
    "art:webp": "python scripts/to_webp.py",
    "art:audit": "python scripts/pixel_audit.py",
    "art:tone": "python scripts/stylecheck.py --world",
    "art:fit": "python scripts/fit_resolution.py",
    "art:grade": "python scripts/regrade.py",
    "art:sheet": "python scripts/contact_sheet.py --unique --scale 2",
    "world:path": "node scripts/path_audit.mjs",
    "world:plan": "python scripts/plan_view.py",
    "world:preview": "python scripts/preview_scene.py",
    "art:depth": "python scripts/depth_grade.py",
    "profile": "node scripts/profile_frame.mjs",
    "budget": "node scripts/load_budget.mjs",
    "preload": "node scripts/build_preload.mjs",
    "check:preload": "node scripts/build_preload.mjs --check",
    "share-images": "python scripts/make_share_images.py",
    "serve": "python scripts/serve.py"
  },
  "keywords": [],
  "author": "khmurakami",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "jsdom": "^28.1.0",
    "vitest": "^2.1.0"
  }
}
